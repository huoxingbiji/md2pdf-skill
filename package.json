  "description": "Quality-gated Markdown to PDF converter with clickable TOC, syntax highlighting, KaTeX and Mermaid",
  "license": "MIT",
  "author": "huoxingbiji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoxingbiji/md2pdf-skill.git"
  },
